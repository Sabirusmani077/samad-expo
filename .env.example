# ==============================================================================
# MDK ENTERPRISES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and replace placeholders with actual credentials.
# NEVER commit real secrets or private API keys to version control.
# ==============================================================================

# 1. APPLICATION & SECURITY
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_JWT_SECRET="replace-with-at-least-32-character-random-cryptographic-secret"
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional path to the JSON data file (useful for isolated QA or separate deployments).
MDK_DB_FILE=""

# 2. DATABASE CONFIGURATION
# Supports local embedded transactional store out of the box (data/mdk-store.json)
# or PostgreSQL / LibSQL connection string when deployed to managed hosting.
DATABASE_URL="postgresql://username:password@localhost:5432/mdk_enterprises"

# 3. PAYMENT GATEWAY CONFIGURATION (OFFICIAL RAZORPAY INTEGRATION)
# Mode: "sandbox" (safe test mode) or "live" (production mode)
PAYMENT_MODE="sandbox"
PAYMENT_PROVIDER="razorpay"

# Razorpay Credentials (Obtain from https://dashboard.razorpay.com -> Settings -> API Keys)
# Once you create your Razorpay account, paste your Key ID and Key Secret below:
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_with_test_key_secret"
# Webhook Secret from Razorpay Dashboard > Settings > Webhooks (for /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"
# Keep true while testing; switch to false when going live with production keys
PAYMENTS_TEST_MODE="true"

# Cashfree Credentials (Optional alternative — https://merchant.cashfree.com)
CASHFREE_APP_ID="cf_test_placeholder_app_id"
CASHFREE_SECRET_KEY="cf_test_placeholder_secret_key"
CASHFREE_WEBHOOK_SECRET="whsec_placeholder_cashfree_webhook_secret"

# 4. AI SHOPPING ASSISTANT (MDK ASSISTANT)
# Optional: Provide GEMINI_API_KEY or OPENAI_API_KEY to enable LLM synthesis
# grounded in live catalogue & store policy data. When unset, MDK Assistant
# automatically uses its built-in deterministic live catalogue & FAQ engine.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_RATE_LIMIT_PER_MINUTE="20"

# 5. TRANSACTIONAL EMAIL SERVICE (RESEND / SMTP)
# Leave empty until configured; the app honestly reports email dispatch status.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# 6. WHATSAPP BUSINESS & SOCIAL LINKS (Can also be updated via Admin Dashboard)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# 7. OPTIONAL CONNECTED WEBSITE ANALYTICS INGESTION
# Set a random server-only token and use it as an Authorization: Bearer token
# from approved independent websites. Never expose this value in browser code.
MD_ANALYTICS_INGEST_TOKEN=""
